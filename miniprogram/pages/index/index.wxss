/* ---- 柜子网格 ---- */
.cabinet-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}
.cabinet-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx 24rpx;
  transition: transform 0.15s;
}
.cabinet-card:active {
  transform: scale(0.96);
}
.cabinet-icon {
  font-size: 56rpx;
  margin-bottom: 10rpx;
}
.cabinet-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.cabinet-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  display: flex;
  gap: 10rpx;
}

/* ---- FAB ---- */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 180rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 24rpx rgba(212, 114, 78, 0.35);
  z-index: 100;
  transition: transform 0.15s;
}
.fab:active {
  transform: scale(0.92);
}
.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ---- 弹窗 ---- */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal {
  width: 620rpx;
  padding: 44rpx;
  border-radius: var(--radius);
  background: #fff;
  box-shadow: var(--shadow-lg);
}
.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--text-primary);
}
.modal-input {
  width: 100%;
  height: 84rpx;
  background: var(--bg-primary);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  box-sizing: border-box;
}

.icon-picker {
  margin-top: 24rpx;
}
.picker-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  display: block;
}
.icon-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.icon-option {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 16rpx;
  background: var(--bg-primary);
  border: 2rpx solid var(--border);
  transition: all 0.15s;
}
.icon-option.active {
  border-color: var(--accent);
  background: var(--accent-light);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.modal-actions .btn-secondary,
.modal-actions .btn-primary {
  flex: 1;
}
