.page-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--text-primary);
}

.photo-area {
  width: 100%;
  aspect-ratio: 4/3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 28rpx;
  position: relative;
}
.preview-img { width: 100%; height: 100%; }
.retake-hint {
  position: absolute;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0,0,0,0.35);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.camera-icon { font-size: 72rpx; }
.camera-hint { font-size: 28rpx; color: var(--text-muted); }

.field { margin-bottom: 24rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.cabinet-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}
.selector-text { font-size: 30rpx; color: var(--text-primary); }
.selector-text.placeholder { color: var(--text-muted); }
.arrow { font-size: 32rpx; color: var(--text-muted); }

.desc-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 16rpx;
  width: 100%;
}

/* 柜子选择器弹窗 */
.modal-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.3);
  display: flex; align-items: flex-end; justify-content: center;
  z-index: 999;
}
.picker-modal {
  width: 100%;
  max-height: 70vh;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
}
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.picker-title { font-size: 34rpx; font-weight: 700; }
.picker-close { font-size: 34rpx; color: var(--text-muted); padding: 8rpx; }
.picker-crumbs { margin-bottom: 12rpx; }
.crumb-back { font-size: 28rpx; color: var(--accent); }
.picker-list { max-height: 50vh; }
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid var(--border);
}
.picker-item-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}
.picker-icon { font-size: 32rpx; }
.picker-name { font-size: 30rpx; }
.picker-drill {
  font-size: 24rpx;
  color: var(--accent);
  padding: 8rpx 16rpx;
}
.picker-empty {
  text-align: center;
  padding: 40rpx;
  color: var(--text-muted);
  font-size: 28rpx;
}
